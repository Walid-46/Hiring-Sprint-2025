{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "maxLambdaSize": "50mb",
        "zeroConfig": true
      }
    }
  ],
  "framework": "nextjs",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend"
}
